# Copy to .env and fill in. Nothing here is a secret; there are no keys of any kind.
# Base URL of the Horizon server to read from. Required. Chooses the network (mainnet or testnet).
HORIZON_URL=
PORT=
HOST=
# Origins allowed to call the API from a browser, comma separated. Empty: no CORS headers.
CORS_ORIGINS=
# SQLite file for the public-history cache. Empty: in-memory cache.
CACHE_DB=
MAX_BODY_BYTES=
MAX_PRICE_CSV_BYTES=
MAX_EVENTS=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
# Set to true only behind a proxy you control.
TRUST_PROXY=
